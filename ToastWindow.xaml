<Window x:Class="Kontro.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Kontro"
        Title="Kontro"
        Width="360" Height="144"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        ShowActivated="False" Focusable="False" IsHitTestVisible="False"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <!--
        As folgas nao sao decorativas: a sombra tem desfoque 32 e desce 18, entao
        precisa de cerca de 34px abaixo do painel e 16 nas laterais para se dissipar.
        Com folga menor ela bate no limite da janela e corta num quadrado. Em cima
        sobra pouca sombra (a direcao e para baixo), mas a folga precisa acomodar os
        12px que o painel sobe no comeco da animacao.
    -->
    <Border Margin="20,24,20,44" CornerRadius="{StaticResource RadiusWindow}"
            Background="{StaticResource Ink}"
            BorderBrush="{StaticResource Stroke}" BorderThickness="1"
            Effect="{StaticResource FlyoutShadow}">
        <Border.RenderTransform>
            <TranslateTransform x:Name="Deslize" Y="-12" />
        </Border.RenderTransform>

        <Grid Margin="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Width="44" Height="44" VerticalAlignment="Center">
                <local:RingControl x:Name="Ring" StrokeThickness="4"
                                   TrackBrush="{StaticResource RingTrack}" />
                <Viewbox MaxWidth="28" MaxHeight="18" Stretch="Uniform"
                         HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="PercentText" Style="{StaticResource DisplayText}" Text="--" />
                </Viewbox>
                <!-- ocupa o miolo quando nao ha numero: anel vazio parece defeito,
                     o controle diz de quem e a carga que esta sendo esperada -->
                <Path x:Name="Glifo" Width="18" Height="18" Stretch="Uniform"
                      Fill="{StaticResource TextSecondary}"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Visibility="Collapsed" />
            </Grid>

            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="DeviceText" Style="{StaticResource SubtitleText}"
                           Text="Controle" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="StateText" Style="{StaticResource CaptionText}"
                           Margin="0,3,0,0" Text="" />
            </StackPanel>
        </Grid>
    </Border>
</Window>

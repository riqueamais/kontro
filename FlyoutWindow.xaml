<Window x:Class="Kontro.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Kontro"
        Title="Kontro"
        Width="376" Height="512"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Border Margin="18" CornerRadius="20"
            Background="{StaticResource PanelBg}"
            BorderBrush="#26FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.6" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="22,18,22,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- cabecalho -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock x:Name="TitleText" Text="Controle"
                               FontFamily="Segoe UI" FontSize="14.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SubtitleText" Text=""
                               Style="{StaticResource Caption}" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <Border x:Name="ModePill" Grid.Column="1"
                        VerticalAlignment="Top" CornerRadius="11" Padding="10,5"
                        Background="#1F4AA8FF">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ModeDot" Width="6" Height="6" Margin="0,0,6,0"
                                 VerticalAlignment="Center" Fill="{StaticResource Bt}"/>
                        <TextBlock x:Name="ModeText" Text="Bluetooth"
                                   FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource Bt}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- anel -->
            <Grid Grid.Row="1" Height="196" Margin="0,12,0,0">
                <Ellipse x:Name="Glow" Width="230" Height="230" Opacity="0.5"/>
                <local:RingControl x:Name="Ring" Width="176" Height="176" StrokeThickness="13"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock x:Name="PercentText" Text="--"
                                   FontFamily="Segoe UI" FontSize="54" FontWeight="Light"
                                   Foreground="{StaticResource TextPrimary}"
                                   LineHeight="58" LineStackingStrategy="BlockLineHeight"/>
                        <TextBlock x:Name="PercentSign" Text="%" Margin="3,0,0,10"
                                   VerticalAlignment="Bottom"
                                   FontFamily="Segoe UI" FontSize="17"
                                   Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                    <TextBlock x:Name="StateLabel" Text="" HorizontalAlignment="Center"
                               Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>

            <!-- estimativa -->
            <StackPanel Grid.Row="2" Margin="0,4,0,0">
                <TextBlock x:Name="EstimateText" Text=""
                           HorizontalAlignment="Center"
                           FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"/>
                <TextBlock x:Name="DrainText" Text="" TextAlignment="Center"
                           HorizontalAlignment="Center" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
            </StackPanel>

            <!-- historico -->
            <Grid Grid.Row="3" Margin="0,16,0,0">
                <TextBlock Text="ÚLTIMAS 24 HORAS" Style="{StaticResource Caption}"/>
                <TextBlock x:Name="SparkHint" HorizontalAlignment="Right" Style="{StaticResource Caption}"/>
            </Grid>
            <local:Sparkline x:Name="Spark" Grid.Row="4" Height="56" Margin="0,8,0,0"/>

            <!-- rodape -->
            <Grid Grid.Row="5" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="2" Height="1" VerticalAlignment="Top"
                        Background="{StaticResource HairLine}"/>
                <TextBlock x:Name="UpdatedText" Grid.Column="0"
                           VerticalAlignment="Center" Margin="0,15,8,0"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource Body}" FontSize="11.5"/>
                <Button x:Name="QuitButton" Grid.Column="1" Margin="0,10,0,0"
                        Style="{StaticResource Ghost}" Content="Sair"/>
            </Grid>

        </Grid>
    </Border>
</Window>



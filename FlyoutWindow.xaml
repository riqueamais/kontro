<Window x:Class="Kontro.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Kontro"
        Title="Kontro"
        Width="352" Height="252"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <!-- a janela e maior que o painel de proposito: a folga acomoda a sombra -->
    <Border Margin="16" CornerRadius="{StaticResource RadiusWindow}"
            Background="{StaticResource Ink}"
            BorderBrush="{StaticResource Stroke}" BorderThickness="1"
            Effect="{StaticResource FlyoutShadow}">

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- anel a esquerda, leitura a direita -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Width="96" Height="96" VerticalAlignment="Center">
                    <local:RingControl x:Name="Ring" StrokeThickness="7"
                                       TrackBrush="{StaticResource RingTrack}" />
                    <!-- o Viewbox impede que "100%" estoure o interior do anel -->
                    <Viewbox MaxWidth="62" MaxHeight="40" Stretch="Uniform"
                             HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="PercentText" Style="{StaticResource DisplayText}" Text="--" />
                    </Viewbox>
                </Grid>

                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="DeviceText" Style="{StaticResource SubtitleText}"
                               Text="Controle" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="EstimateText" Style="{StaticResource BodyText}"
                               Margin="0,6,0,0" Text="" />
                    <TextBlock x:Name="UpdatedText" Style="{StaticResource MonoText}"
                               Margin="0,8,0,0" Text="" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Height="1" Margin="0,12,0,0"
                    Background="{StaticResource Stroke}" />

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,12,0,0">
                <Button x:Name="SettingsButton" Style="{StaticResource GhostButton}"
                        Content="Configurações" Margin="0,0,8,0" />
                <Button x:Name="RefreshButton" Style="{StaticResource GhostButton}"
                        Content="Atualizar" />
            </StackPanel>
        </Grid>
    </Border>
</Window>

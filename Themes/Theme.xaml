<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!-- Kontro · sistema "Anel" · cores -->
  <Color x:Key="InkColor">#FF0B0E11</Color>
  <Color x:Key="SurfaceColor">#FF0F1318</Color>
  <Color x:Key="SurfaceAltColor">#FF151A20</Color>
  <Color x:Key="StrokeColor">#FF1E252C</Color>
  <Color x:Key="StrokeStrongColor">#FF2A333B</Color>
  <Color x:Key="TextPrimaryColor">#FFE8ECEF</Color>
  <Color x:Key="TextSecondaryColor">#FF9AA4AD</Color>
  <Color x:Key="TextTertiaryColor">#FF6B757D</Color>
  <Color x:Key="AccentGreenColor">#FF5FE083</Color>
  <Color x:Key="AccentTealColor">#FF35D7A8</Color>
  <Color x:Key="AmberColor">#FFF2C14E</Color>
  <Color x:Key="RedColor">#FFF2564E</Color>
  <Color x:Key="GrayColor">#FF8D979F</Color>

  <SolidColorBrush x:Key="Ink" Color="{StaticResource InkColor}" />
  <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceAlt" Color="{StaticResource SurfaceAltColor}" />
  <SolidColorBrush x:Key="Stroke" Color="{StaticResource StrokeColor}" />
  <SolidColorBrush x:Key="StrokeStrong" Color="{StaticResource StrokeStrongColor}" />
  <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="TextTertiary" Color="{StaticResource TextTertiaryColor}" />
  <SolidColorBrush x:Key="AccentGreen" Color="{StaticResource AccentGreenColor}" />
  <SolidColorBrush x:Key="AccentTeal" Color="{StaticResource AccentTealColor}" />
  <SolidColorBrush x:Key="Amber" Color="{StaticResource AmberColor}" />
  <SolidColorBrush x:Key="Red" Color="{StaticResource RedColor}" />
  <SolidColorBrush x:Key="Gray" Color="{StaticResource GrayColor}" />

  <LinearGradientBrush x:Key="RingGradient" StartPoint="0.23,0.16" EndPoint="0.78,0.86">
    <GradientStop Color="{StaticResource AccentGreenColor}" Offset="0" />
    <GradientStop Color="{StaticResource AccentTealColor}" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="RingTrack" Color="#FFFFFFFF" Opacity="0.13" />

  <!-- tipografia -->
  <FontFamily x:Key="FontDisplay">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="FontText">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="FontMono">Consolas</FontFamily>

  <Style x:Key="DisplayText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
    <Setter Property="FontSize" Value="34" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
  </Style>
  <Style x:Key="TitleText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
  </Style>
  <Style x:Key="SubtitleText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontText}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
  </Style>
  <Style x:Key="BodyText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontText}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="CaptionText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontText}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource TextTertiary}" />
  </Style>
  <Style x:Key="MonoText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource TextTertiary}" />
  </Style>

  <!-- espaço e raio -->
  <sys:Double x:Key="Space1">4</sys:Double>
  <sys:Double x:Key="Space2">8</sys:Double>
  <sys:Double x:Key="Space3">12</sys:Double>
  <sys:Double x:Key="Space4">16</sys:Double>
  <sys:Double x:Key="Space5">24</sys:Double>
  <sys:Double x:Key="Space6">32</sys:Double>
  <CornerRadius x:Key="RadiusField">8</CornerRadius>
  <CornerRadius x:Key="RadiusCard">12</CornerRadius>
  <CornerRadius x:Key="RadiusWindow">16</CornerRadius>
  <Thickness x:Key="CardPadding">16</Thickness>

  <!-- elevação: só o flyout tem sombra -->
  <DropShadowEffect x:Key="FlyoutShadow" BlurRadius="32" ShadowDepth="18"
                    Direction="270" Color="#FF000000" Opacity="0.55" />

  <!-- geometria da marca: mesma dos PNGs -->
  <PathGeometry x:Key="ControllerPad"
    Figures="M168 158H344C392 158 424 186 436 232L462 330C476 382 452 418 414 418C386 418 366 400 352 372L330 328C322 312 308 304 292 304H220C204 304 190 312 182 328L160 372C146 400 126 418 98 418C60 418 36 382 50 330L76 232C88 186 120 158 168 158Z" />

  <Duration x:Key="MotionFast">0:0:0.12</Duration>
  <Duration x:Key="MotionBase">0:0:0.18</Duration>
  <Duration x:Key="MotionSlow">0:0:0.24</Duration>
</ResourceDictionary>

<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Limpa as fontes herdadas da maquina. Sem isso, um feed privado configurado
    globalmente responde 401 e derruba o restore do projeto inteiro, inclusive
    para quem clonar o repositorio.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>



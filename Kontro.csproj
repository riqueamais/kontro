<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Kontro</AssemblyName>
    <RootNamespace>Kontro</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>pt-BR;en</SatelliteResourceLanguages>

    <!-- Main proprio: o Velopack precisa rodar antes de qualquer janela existir -->
    <StartupObject>Kontro.Program</StartupObject>

    <!-- identidade que aparece nas propriedades do executavel -->
    <Product>Kontro</Product>
    <AssemblyTitle>Kontro</AssemblyTitle>
    <Description>Bateria do seu controle, em tempo real, na bandeja do sistema.</Description>
    <Company>riqueamais</Company>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <Copyright>© 2026 riqueamais</Copyright>

    <!-- o Velopack empacota uma pasta, entao nada de arquivo unico aqui -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- App.xaml deixa de ser o ponto de entrada para o Main proprio valer -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <!-- o mesmo ico serve de icone do executavel e da janela -->
    <Resource Include="app.ico" />
  </ItemGroup>
</Project>


<Window x:Class="Kontro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Kontro"
        Title="Kontro"
        Icon="app.ico"
        Width="480" Height="680"
        MinWidth="480" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Ink}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- cabecalho de 56px: icone de 20 e o nome -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Image Source="app.ico" Width="20" Height="20" VerticalAlignment="Center" />
            <TextBlock Text="Kontro" Style="{StaticResource TitleText}"
                       Margin="12,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel>

                <!-- estado atual -->
                <TextBlock Text="ESTADO ATUAL" Style="{StaticResource CaptionText}" Margin="4,0,0,8" />
                <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Width="72" Height="72">
                            <local:RingControl x:Name="Ring" StrokeThickness="6"
                                               TrackBrush="{StaticResource RingTrack}" />
                            <Viewbox MaxWidth="46" MaxHeight="30" Stretch="Uniform"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="PercentText" Style="{StaticResource DisplayText}" Text="--" />
                            </Viewbox>
                            <!-- ocupa o miolo quando nao ha numero: anel vazio parece defeito,
                     o controle diz de quem e a carga que esta sendo esperada -->
                            <Path x:Name="Glifo" Width="28" Height="28" Stretch="Uniform"
                      Fill="{StaticResource TextSecondary}"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Visibility="Collapsed" />
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="DeviceText" Style="{StaticResource SubtitleText}"
                                       Text="Controle" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="StateText" Style="{StaticResource BodyText}" Margin="0,6,0,0" />
                            <TextBlock x:Name="UpdatedText" Style="{StaticResource MonoText}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- historico -->
                <TextBlock Text="HISTÓRICO" Style="{StaticResource CaptionText}" Margin="4,0,0,8" />
                <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                    <StackPanel>
                        <Grid>
                            <TextBlock x:Name="HistoryRange" Style="{StaticResource CaptionText}" />
                            <TextBlock Text="últimas 24 h" Style="{StaticResource CaptionText}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                        <local:Sparkline x:Name="Spark" Height="64" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <!-- configuracoes -->
                <TextBlock Text="CONFIGURAÇÕES" Style="{StaticResource CaptionText}" Margin="4,0,0,8" />
                <Border Style="{StaticResource Card}" Margin="0,0,0,24" Padding="4,4">
                    <StackPanel>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Iniciar com o Windows" Style="{StaticResource SubtitleText}" FontSize="14" />
                                    <TextBlock Text="Sobe junto com o sistema e já começa a monitorar."
                                               Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" x:Name="SwStartup" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Iniciar minimizado" Style="{StaticResource SubtitleText}" FontSize="14" />
                                    <TextBlock Text="Abre direto na bandeja, sem mostrar esta janela."
                                               Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" x:Name="SwStartMinimized" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Ao clicar no X" Style="{StaticResource SubtitleText}" FontSize="14" />
                                    <TextBlock Text="Decide se o app continua vivo em segundo plano."
                                               Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="BtnCloseAction" Style="{StaticResource GhostButton}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Avisar com bateria baixa" Style="{StaticResource SubtitleText}" FontSize="14" />
                                    <TextBlock Text="Só no Bluetooth, que é onde existe percentual real."
                                               Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" x:Name="SwNotify" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Avisar ao conectar" Style="{StaticResource SubtitleText}" FontSize="14" />
                                    <TextBlock Text="Mostra a carga no topo da tela quando o controle liga."
                                               Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" x:Name="SwConnectToast" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Sobreposição na tela" Style="{StaticResource SubtitleText}" FontSize="14" />
                                    <TextBlock Text="Medidor fixo num canto, como um contador de quadros."
                                               Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Button x:Name="BtnOverlayMode" Grid.Column="1" Style="{StaticResource GhostButton}"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Canto da sobreposição" Style="{StaticResource SubtitleText}" FontSize="14" />
                                    <TextBlock Text="Em qual canto do monitor em uso ela fica."
                                               Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Button x:Name="BtnOverlayCorner" Grid.Column="1" Style="{StaticResource GhostButton}"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border x:Name="LinhaMonitor" Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Monitor da sobreposição" Style="{StaticResource SubtitleText}" FontSize="14" />
                                    <TextBlock Text="Prenda a um monitor para ela não seguir o clique."
                                               Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Button x:Name="BtnOverlayMonitor" Grid.Column="1" Style="{StaticResource GhostButton}"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Aviso de bateria baixa" Style="{StaticResource SubtitleText}" FontSize="14" />
                                    <TextBlock x:Name="WarnValue" Style="{StaticResource MonoText}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <Slider x:Name="SlWarn" Style="{StaticResource ThresholdSlider}"
                                        Minimum="10" Maximum="60" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Aviso crítico" Style="{StaticResource SubtitleText}" FontSize="14" />
                                    <TextBlock x:Name="CritValue" Style="{StaticResource MonoText}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <Slider x:Name="SlCrit" Style="{StaticResource ThresholdSlider}"
                                        Minimum="3" Maximum="30" TickFrequency="1" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- atualizacoes -->
                <TextBlock Text="ATUALIZAÇÕES" Style="{StaticResource CaptionText}" Margin="4,0,0,8" />
                <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="4,4">
                    <StackPanel>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Procurar automaticamente" Style="{StaticResource SubtitleText}" FontSize="14" />
                                    <TextBlock Text="Consulta as releases uma vez por dia e avisa se houver versão nova."
                                               Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" x:Name="SwAutoUpdate" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Name="VersionText" Style="{StaticResource SubtitleText}" FontSize="14" />
                                    <TextBlock x:Name="UpdateStatus" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="BtnCheckUpdate" Style="{StaticResource GhostButton}"
                                        Content="Procurar agora" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- rodape -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Border Height="1" VerticalAlignment="Top" Background="{StaticResource Stroke}" />
            <TextBlock x:Name="FooterHint" Style="{StaticResource CaptionText}"
                       VerticalAlignment="Center" Margin="0,16,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="BtnQuit" Style="{StaticResource GhostButton}"
                        Content="Encerrar app" Margin="0,0,8,0" />
                <Button x:Name="BtnDone" Style="{StaticResource PrimaryButton}" Content="Concluir" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
